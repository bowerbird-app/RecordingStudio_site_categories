<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(anchor_url: "/") %>

  <% if recording_studio_site_categories_flatpack_component_available?(
    "FlatPack::PageTitle::Component",
    "FlatPack::Card::Component",
    "FlatPack::Table::Component"
  ) %>
    <%= render FlatPack::PageTitle::Component.new(
      title: t("recording_studio.site_categories.index.title"),
      subtitle: t("recording_studio.site_categories.index.subtitle"),
      variant: :h1
    ) %>

    <%= render FlatPack::Table::Component.new(data: @groups, class: "text-sm") do |table| %>
      <% table.column(title: t("recording_studio.site_categories.index.columns.key"), html: ->(group) { group.key.to_s }) %>
      <% table.column(title: t("recording_studio.site_categories.index.columns.label"), html: ->(group) { group.label }) %>
      <% table.column(title: t("recording_studio.site_categories.index.columns.items"), html: ->(group) { group.items.join(", ") }) %>
    <% end %>
  <% else %>
    <div class="space-y-2">
      <h1 class="text-2xl font-semibold"><%= t("recording_studio.site_categories.index.title") %></h1>
      <p class="text-sm text-slate-600"><%= t("recording_studio.site_categories.index.subtitle") %></p>
    </div>

    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-4 py-3 font-medium text-slate-900"><%= t("recording_studio.site_categories.index.columns.key") %></th>
            <th scope="col" class="px-4 py-3 font-medium text-slate-900"><%= t("recording_studio.site_categories.index.columns.label") %></th>
            <th scope="col" class="px-4 py-3 font-medium text-slate-900"><%= t("recording_studio.site_categories.index.columns.items") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% @groups.each do |group| %>
            <tr>
              <td class="px-4 py-3 align-top"><%= group.key %></td>
              <td class="px-4 py-3 align-top"><%= group.label %></td>
              <td class="px-4 py-3 align-top"><%= group.items.join(", ") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
