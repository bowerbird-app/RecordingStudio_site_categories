<div class="mx-auto flex w-full min-w-0 max-w-4xl flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "View Helpers",
    subtitle: "Available helpers from the recording_studio_site_categories gem.",
    variant: :h1
  ) %>

  <%# ── Label Helper ── %>
  <section id="label-helper">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Label helper",
      subtitle: "recording_studio_site_category_label returns the display label for a registered group key.",
      variant: :h2
    ) %>

    <div class="min-w-0 max-w-full overflow-x-auto">
    <%= render FlatPack::CodeBlock::Component.new(
      code: "recording_studio_site_category_label(:colour)  # => \"#{@colour_label}\"",
      language: "ruby"
    ) %>
    </div>
  </section>

  <%# ── Items / Options Helper ── %>
  <section id="items-helper">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Items helper",
      subtitle: "recording_studio_site_category_items and options return the allowed values for a registered group.",
      variant: :h2
    ) %>

    <div class="min-w-0 max-w-full overflow-x-auto">
    <%= render FlatPack::CodeBlock::Component.new(
      code: "recording_studio_site_category_items(:colour)   # => #{@colour_items.inspect}\nrecording_studio_site_category_options(:colour) # => #{recording_studio_site_category_options(:colour).inspect}",
      language: "ruby"
    ) %>
    </div>
  </section>

  <%# ── Validation Helper ── %>
  <section id="validation-helper">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Valid? helper",
      subtitle: "recording_studio_site_category_valid? checks whether a value belongs to a registered group.",
      variant: :h2
    ) %>

    <%
      validation_rows = @valid_values.map do |value|
        {
          value: value,
          valid: recording_studio_site_category_valid?(:colour, value) ? "✅" : "❌",
          usage: %(recording_studio_site_category_valid?(:colour, "#{value}"))
        }
      end
    %>
    <%= render FlatPack::Table::Component.new(data: validation_rows, min_width: :none, class: "w-full max-w-full text-sm") do |table| %>
      <% table.column(title: "Value", html: ->(row) { row[:value] }) %>
      <% table.column(title: "Valid?", html: ->(row) { row[:valid] }) %>
      <% table.column(title: "Usage", html: ->(row) { tag.span(row[:usage], class: "font-mono text-xs text-slate-500") }) %>
    <% end %>
  </section>

  <%# ── Select Helper Demo ── %>
  <section id="select-helper">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Select helper",
      subtitle: "recording_studio_site_category_select renders a FlatPack select when available, or a Rails select otherwise.",
      variant: :h2
    ) %>

    <%# ── Single Select ── %>
    <p class="text-sm text-slate-600">
      <strong>Single select:</strong>
    </p>

    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <%= form_with model: @demo_page, url: "#", method: :get, builder: nil do |form| %>
        <%= recording_studio_site_category_select(form, :colour, attribute_name: :site_colour, searchable: true) %>
      <% end %>
    </div>

    <div class="min-w-0 max-w-full overflow-x-auto">
    <%= render FlatPack::CodeBlock::Component.new(code: @select_usage_code) %>
    </div>

    <%# ── Multiple Select ── %>
    <p class="text-sm text-slate-600 mt-6">
      <strong>Multiple select:</strong>
    </p>

    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <%= form_with model: @demo_page, url: "#", method: :get, builder: nil do |form| %>
        <%= recording_studio_site_category_select(
          form,
          :publication_type,
          attribute_name: :site_publications,
          searchable: true,
          multiple: true
        ) %>
      <% end %>
    </div>

    <div class="min-w-0 max-w-full overflow-x-auto">
    <%= render FlatPack::CodeBlock::Component.new(code: @select_multiple_direct_code) %>
    </div>
  </section>
</div>